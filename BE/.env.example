# SkyDesk AI backend configuration.
# Copy to .env and fill in the secrets: cp .env.example .env   (never commit .env)

# App
APP_NAME=SkyDesk AI
APP_VERSION=0.1.0

# Groq API (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# 0 = same answer every time
GROQ_TEMPERATURE=0
GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=2
# gpt-oss thinks before answering: low = fastest
GROQ_REASONING_EFFORT=low

# MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skydesk

# Ticket rules
# SLA response time (hours) per priority
SLA_HOURS={"P1": 4, "P2": 8, "P3": 24, "P4": 72}
# How many similar tickets find_similar_tickets returns
SIMILAR_TICKETS_LIMIT=5

# Agent
# Re-run the LLM step if the model returns a broken tool call
AGENT_RETRY_ATTEMPTS=3

# Pinecone (https://app.pinecone.io): vector DB for RAG, hosted embedding + rerank models
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=saffron-it-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_DIMENSION=1024
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# RAG
RAG_KB_DIR=data/kb
# Max characters per chunk; a section longer than this is split with overlap
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
# Vector search returns TOP_K candidates, the reranker keeps the best TOP_N
RAG_TOP_K=8
RAG_TOP_N=3

# Auth (JWT)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-random-64-character-hex-secret
JWT_ALGORITHM=HS256
# How long a login stays valid (one airport shift)
JWT_EXPIRE_MINUTES=480
# Frontend addresses allowed to call this API (browser CORS)
CORS_ORIGINS=["http://localhost:3000"]

# Organisation
AIRLINE_NAME=Saffron Air
# Prefixes for new IDs, e.g. SKY-1061, APR-7
TICKET_ID_PREFIX=SKY
APPROVAL_ID_PREFIX=APR
# Team whose engineers may approve any access request (besides the requester's line manager)
ACCESS_APPROVER_TEAM=Identity & Access Management
